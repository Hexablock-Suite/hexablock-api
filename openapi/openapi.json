{
  "components": {
    "schemas": {
      "ErrorDto": {
        "properties": {
          "details": {
            "description": "One entry per problem when a request has several. Empty otherwise.",
            "example": [
              "gameId should not be empty"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "error": {
            "description": "The standard reason phrase of the status.",
            "example": "Not Found",
            "type": "string"
          },
          "message": {
            "description": "One sentence that a client can show or log.",
            "example": "Cannot GET /levels/unknown",
            "type": "string"
          },
          "path": {
            "description": "The request path.",
            "example": "/levels/unknown",
            "type": "string"
          },
          "statusCode": {
            "description": "The HTTP status code.",
            "example": 404,
            "type": "number"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "details",
          "path"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "example": "ok",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Users, progress, leaderboards and level definitions.",
    "title": "HexaBlock API",
    "version": "0.0.1"
  },
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "The API process is up."
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
