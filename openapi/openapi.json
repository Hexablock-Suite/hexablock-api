{
  "components": {
    "schemas": {
      "CredentialsDto": {
        "properties": {
          "password": {
            "example": "correct horse battery",
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "username": {
            "description": "Letters, digits, dots, hyphens or underscores.",
            "example": "ada",
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9._-]{3,32}$",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "CurrentUserDto": {
        "properties": {
          "userId": {
            "description": "The user id.",
            "example": "0b6f6a4e-1c2d-4e5f-8a9b-0c1d2e3f4a5b",
            "type": "string"
          }
        },
        "required": [
          "userId"
        ],
        "type": "object"
      },
      "ErrorDto": {
        "properties": {
          "details": {
            "description": "One entry per problem when a request has several. Empty otherwise. No entry holds the query string.",
            "example": [
              "gameId should not be empty"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "error": {
            "description": "The standard reason phrase of the status.",
            "example": "Not Found",
            "type": "string"
          },
          "message": {
            "description": "One sentence that a client can show or log. It never holds the query string.",
            "example": "Cannot GET /levels/unknown",
            "type": "string"
          },
          "path": {
            "description": "The request path, without the query string.",
            "example": "/levels/unknown",
            "type": "string"
          },
          "statusCode": {
            "description": "The HTTP status code.",
            "example": 404,
            "type": "number"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "details",
          "path"
        ],
        "type": "object"
      },
      "FitPieceDto": {
        "properties": {
          "cells": {
            "example": [
              [
                0,
                0
              ],
              [
                1,
                0
              ]
            ],
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "type": "array"
          },
          "id": {
            "description": "A non-blank text, unique in the level.",
            "example": "a",
            "type": "string"
          }
        },
        "required": [
          "id",
          "cells"
        ],
        "type": "object"
      },
      "FitPlacementDto": {
        "properties": {
          "at": {
            "example": [
              2,
              0
            ],
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "piece": {
            "description": "The id of a piece of the level.",
            "example": "b",
            "type": "string"
          },
          "rotation": {
            "description": "Rotation steps of the topology. A negative count turns the other way.",
            "example": 1,
            "type": "integer"
          }
        },
        "required": [
          "piece",
          "rotation",
          "at"
        ],
        "type": "object"
      },
      "FitSectionDto": {
        "properties": {
          "figure": {
            "description": "The cells that the player covers.",
            "example": [
              [
                0,
                0
              ],
              [
                1,
                0
              ]
            ],
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "type": "array"
          },
          "pieces": {
            "items": {
              "$ref": "#/components/schemas/FitPieceDto"
            },
            "type": "array"
          },
          "stars": {
            "description": "The star thresholds, from the first star up.",
            "items": {
              "$ref": "#/components/schemas/FitStarDto"
            },
            "type": "array"
          },
          "witness": {
            "description": "The solution of the designer. It covers the figure exactly (A5).",
            "items": {
              "$ref": "#/components/schemas/FitPlacementDto"
            },
            "type": "array"
          }
        },
        "required": [
          "figure",
          "pieces",
          "witness",
          "stars"
        ],
        "type": "object"
      },
      "FitStarDto": {
        "properties": {
          "maxElapsedMs": {
            "example": 120000,
            "minimum": 0,
            "type": "integer"
          },
          "maxMoves": {
            "example": 12,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "maxMoves",
          "maxElapsedMs"
        ],
        "type": "object"
      },
      "FixedSourceDto": {
        "properties": {
          "stacks": {
            "example": [
              [
                "red",
                "red",
                "blue"
              ],
              [
                "green"
              ]
            ],
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array"
          }
        },
        "required": [
          "stacks"
        ],
        "type": "object"
      },
      "GlobalLeaderboardDto": {
        "properties": {
          "gameId": {
            "example": "hexa-lines",
            "type": "string"
          },
          "highScores": {
            "description": "The high scores, the higher score first. Empty for a game that keeps no score, such as Fit and Sort.",
            "items": {
              "$ref": "#/components/schemas/ScoreEntryDto"
            },
            "type": "array"
          },
          "standings": {
            "description": "The totals of the level results: more stars first, then more levels completed, then fewer moves, then less time. Empty for a game with no level results, such as Lines and Merge.",
            "items": {
              "$ref": "#/components/schemas/StandingEntryDto"
            },
            "type": "array"
          }
        },
        "required": [
          "gameId",
          "highScores",
          "standings"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "example": "ok",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "LevelDto": {
        "properties": {
          "gameId": {
            "description": "The game variant: hexa-fit or hexa-sort. Another game has no level files.",
            "example": "hexa-fit",
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "levelId": {
            "description": "A non-blank text, unique in its game.",
            "example": "fit-01",
            "type": "string"
          },
          "order": {
            "description": "The place of the level in the list of its game.",
            "example": 1,
            "minimum": 1,
            "type": "integer"
          },
          "section": {
            "description": "The section of the game: the Fit section or the Sort section.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/FitSectionDto"
              },
              {
                "$ref": "#/components/schemas/SortSectionDto"
              }
            ]
          },
          "topology": {
            "description": "How to read the coordinates, such as hex.",
            "example": "hex",
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "version": {
            "description": "The copy of the level. The update rejects a version lower than the stored one, and accepts an equal or a higher one (S3-10).",
            "example": 1,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "gameId",
          "levelId",
          "order",
          "version",
          "topology",
          "section"
        ],
        "type": "object"
      },
      "LevelEntryDto": {
        "properties": {
          "elapsedMs": {
            "example": 45000,
            "minimum": 0,
            "type": "number"
          },
          "moves": {
            "example": 12,
            "minimum": 0,
            "type": "number"
          },
          "rank": {
            "description": "1 plus the number of rows that are strictly better. A full tie shares a rank, and the next rank skips: 1, 1, 3.",
            "example": 1,
            "minimum": 1,
            "type": "number"
          },
          "stars": {
            "example": 3,
            "minimum": 0,
            "type": "number"
          },
          "userId": {
            "description": "The player. A full tie lists its players by userId ascending.",
            "example": "0b6f6a4e-1c2d-4e5f-8a9b-0c1d2e3f4a5b",
            "type": "string"
          }
        },
        "required": [
          "rank",
          "userId",
          "stars",
          "moves",
          "elapsedMs"
        ],
        "type": "object"
      },
      "LevelLeaderboardDto": {
        "properties": {
          "entries": {
            "description": "More stars first, then fewer moves, then less time (DS-4).",
            "items": {
              "$ref": "#/components/schemas/LevelEntryDto"
            },
            "type": "array"
          },
          "gameId": {
            "example": "hexa-fit",
            "type": "string"
          },
          "levelId": {
            "example": "fit-01",
            "type": "string"
          }
        },
        "required": [
          "gameId",
          "levelId",
          "entries"
        ],
        "type": "object"
      },
      "LevelResultDto": {
        "properties": {
          "elapsedMs": {
            "description": "A non-negative integer.",
            "example": 45000,
            "minimum": 0,
            "type": "number"
          },
          "levelId": {
            "example": "fit-01",
            "type": "string"
          },
          "moves": {
            "description": "A non-negative integer.",
            "example": 12,
            "minimum": 0,
            "type": "number"
          },
          "stars": {
            "description": "A non-negative integer.",
            "example": 3,
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "levelId",
          "stars",
          "moves",
          "elapsedMs"
        ],
        "type": "object"
      },
      "LevelsDto": {
        "properties": {
          "levels": {
            "description": "The levels, by gameId and then by levelId in an answer.",
            "items": {
              "$ref": "#/components/schemas/LevelDto"
            },
            "type": "array"
          }
        },
        "required": [
          "levels"
        ],
        "type": "object"
      },
      "LoginDto": {
        "properties": {
          "password": {
            "example": "correct horse battery",
            "type": "string"
          },
          "username": {
            "example": "ada",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "ProgressDto": {
        "properties": {
          "gameId": {
            "example": "hexa-lines",
            "type": "string"
          },
          "highScore": {
            "description": "The highest score, or null when no sync sent a score.",
            "example": 120,
            "nullable": true,
            "type": "number"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/LevelResultDto"
            },
            "type": "array"
          },
          "updatedAt": {
            "example": "2026-11-06T10:00:00.000Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "gameId",
          "highScore",
          "updatedAt",
          "results"
        ],
        "type": "object"
      },
      "ScoreEntryDto": {
        "properties": {
          "highScore": {
            "example": 2048,
            "minimum": 0,
            "type": "number"
          },
          "rank": {
            "description": "1 plus the number of rows that are strictly better. A full tie shares a rank, and the next rank skips: 1, 1, 3.",
            "example": 1,
            "minimum": 1,
            "type": "number"
          },
          "userId": {
            "description": "The player. A full tie lists its players by userId ascending.",
            "example": "0b6f6a4e-1c2d-4e5f-8a9b-0c1d2e3f4a5b",
            "type": "string"
          }
        },
        "required": [
          "rank",
          "userId",
          "highScore"
        ],
        "type": "object"
      },
      "SeededSourceDto": {
        "properties": {
          "colors": {
            "example": [
              "red",
              "green",
              "blue"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "seed": {
            "example": 20261115,
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "seed",
          "colors"
        ],
        "type": "object"
      },
      "SortSectionDto": {
        "properties": {
          "goals": {
            "description": "The count of stacks to clear.",
            "example": 3,
            "minimum": 1,
            "type": "integer"
          },
          "radius": {
            "example": 2,
            "minimum": 1,
            "type": "integer"
          },
          "source": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SeededSourceDto"
              },
              {
                "$ref": "#/components/schemas/FixedSourceDto"
              }
            ]
          },
          "stars": {
            "description": "The star thresholds, from the first star up.",
            "items": {
              "$ref": "#/components/schemas/SortStarDto"
            },
            "type": "array"
          }
        },
        "required": [
          "radius",
          "goals",
          "source",
          "stars"
        ],
        "type": "object"
      },
      "SortStarDto": {
        "properties": {
          "maxMoves": {
            "example": 40,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "maxMoves"
        ],
        "type": "object"
      },
      "StandingEntryDto": {
        "properties": {
          "elapsedMs": {
            "description": "The total of the elapsed time.",
            "example": 90000,
            "minimum": 0,
            "type": "number"
          },
          "levelsCompleted": {
            "description": "The number of levels with a stored result.",
            "example": 3,
            "minimum": 1,
            "type": "number"
          },
          "moves": {
            "description": "The total of the moves.",
            "example": 40,
            "minimum": 0,
            "type": "number"
          },
          "rank": {
            "description": "1 plus the number of rows that are strictly better. A full tie shares a rank, and the next rank skips: 1, 1, 3.",
            "example": 1,
            "minimum": 1,
            "type": "number"
          },
          "stars": {
            "description": "The total of the stars.",
            "example": 9,
            "minimum": 0,
            "type": "number"
          },
          "userId": {
            "description": "The player. A full tie lists its players by userId ascending.",
            "example": "0b6f6a4e-1c2d-4e5f-8a9b-0c1d2e3f4a5b",
            "type": "string"
          }
        },
        "required": [
          "rank",
          "userId",
          "stars",
          "levelsCompleted",
          "moves",
          "elapsedMs"
        ],
        "type": "object"
      },
      "SyncProgressDto": {
        "properties": {
          "gameId": {
            "description": "The game variant. Required.",
            "example": "hexa-lines",
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "results": {
            "description": "Level results. For each levelId the better result stays: more stars, then fewer moves, then less time; on a full tie the stored result stays.",
            "items": {
              "$ref": "#/components/schemas/LevelResultDto"
            },
            "type": "array"
          },
          "score": {
            "description": "The score of the game. The API keeps the highest one.",
            "example": 120,
            "minimum": 0,
            "nullable": true,
            "type": "number"
          }
        },
        "required": [
          "gameId"
        ],
        "type": "object"
      },
      "TokenDto": {
        "properties": {
          "accessToken": {
            "description": "A signed JWT.",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "type": "string"
          }
        },
        "required": [
          "accessToken"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Users, progress, leaderboards and level definitions.",
    "title": "HexaBlock API",
    "version": "0.0.1"
  },
  "openapi": "3.0.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "AuthController_signIn",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenDto"
                }
              }
            },
            "description": "The credentials are valid."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            },
            "description": "A field is missing or is not a string."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            },
            "description": "The username or the password is wrong."
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserDto"
                }
              }
            },
            "description": "The token is valid."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            },
            "description": "The bearer token is missing, malformed, expired or signed with another key."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "AuthController_signUp",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialsDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The user exists. The body is empty."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            },
            "description": "A field is missing or breaks its rule."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            },
            "description": "Another user has this username, or one that differs only in letter case."
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "The API process is up."
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/leaderboard/{gameId}": {
      "get": {
        "operationId": "LeaderboardController_top",
        "parameters": [
          {
            "in": "path",
            "name": "gameId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GlobalLeaderboardDto"
                }
              }
            },
            "description": "The score board and the standing board of the gameId."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            },
            "description": "The gameId breaks its rule."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            },
            "description": "The bearer token is missing, malformed, expired or signed with another key."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "leaderboard"
        ]
      }
    },
    "/leaderboard/{gameId}/levels/{levelId}": {
      "get": {
        "operationId": "LeaderboardController_topOfLevel",
        "parameters": [
          {
            "in": "path",
            "name": "gameId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "levelId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LevelLeaderboardDto"
                }
              }
            },
            "description": "The board of one level."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            },
            "description": "The gameId or the levelId breaks its rule."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            },
            "description": "The bearer token is missing, malformed, expired or signed with another key."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "leaderboard"
        ]
      }
    },
    "/levels": {
      "get": {
        "operationId": "LevelsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LevelsDto"
                }
              }
            },
            "description": "Every stored level, by gameId and levelId."
          }
        },
        "tags": [
          "levels"
        ]
      },
      "put": {
        "operationId": "LevelsController_update",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LevelsDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Every level of the batch is saved. The body is empty."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorDto"
                }
              }
            },
            "description": "The body has the wrong shape, or a level breaks a rule: a value of the common part, its section, A5, a lower version than the stored one, or a gameId with no level files. Each detail names one level by its gameId and levelId. A level problem saves no level of the batch, except a lower version, which saves the other levels."
