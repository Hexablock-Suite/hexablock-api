{
  "repo": "hexablock-api",
  "parts": [
    { "id": "domain", "title": "Domain", "layers": [1] },
    { "id": "usecases", "title": "Use cases", "layers": [2] },
    { "id": "adapters", "title": "Adapters", "layers": [3] },
    { "id": "infrastructure", "title": "Infrastructure", "layers": [4] }
  ],
  "folders": [
    { "path": "src/domain/", "layer": 1, "part": "domain" },
    { "path": "src/application/", "layer": 2, "part": "usecases" },
    { "path": "src/adapters/", "layer": 3, "part": "adapters" },
    { "path": "src/infrastructure/", "layer": 4, "part": "infrastructure" },
    { "path": "src/", "layer": 4, "part": "infrastructure" }
  ],
  "views": { "domain-": "domain", "uc-": "usecases", "ad-": "adapters", "flow-": null },
  "patterns": {
    "LevelValidators->LevelValidator": "Strategy",
    "UseCaseAspect->UseCase": "Decorator"
  },
  "stereotypeFor": { "AppModule": "module" },
  "staleMembers": [
    { "type": "JwtTokenIssuer", "member": "secret", "equivalent": ["JwtTokenIssuer.jwt"] },
    {
      "type": "ProgressRowMapper",
      "member": "toEntity",
      "equivalent": ["ProgressRowMapper.toAggregate"]
    },
    {
      "type": "ProgressRowMapper",
      "member": "toRows",
      "equivalent": ["ProgressRowMapper.toProgressRow", "ProgressRowMapper.toLevelResultRows"]
    }
  ]
}
