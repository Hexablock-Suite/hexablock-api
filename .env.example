# Example configuration of the API. Copy it to .env for local work and
# replace JWT_SECRET. Never commit a real secret: .gitignore keeps .env out.
# `pnpm openapi:export`, `pnpm openapi:check` and the CI contract job start
# the app with these example values. They never serve a real user.

# The HTTP port.
PORT=3000

# The local Postgres of compose.yaml.
DATABASE_URL=postgres://hexablock:hexablock@localhost:5432/hexablock

# The HS256 key of the session tokens: at least 32 random characters.
# Make one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=example-only-replace-with-32-random-characters
